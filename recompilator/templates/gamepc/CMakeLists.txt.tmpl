cmake_minimum_required(VERSION 3.20)
project({{GAME}}pc LANGUAGES C CXX)

set(CMAKE_C_STANDARD 17)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)


# ── WHERE THE ENGINE IS, found by walking up rather than by counting ../ ──────
# A game tree used to sit at <root>/<game>pc and now sits at <root>/archive/<game>pc, so the
# engine is one level further up than it was (2026-09-07: games should go in a folder, not
# loose in the directory). Looking for it instead of hardcoding the depth means a tree built
# either way keeps working, which matters because every tree already on disk was made the old way.
get_filename_component(_up1 "${CMAKE_CURRENT_SOURCE_DIR}/.."    ABSOLUTE)
get_filename_component(_up2 "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
if(EXISTS "${_up1}/engine/rt64/CMakeLists.txt")
    set(ENGINE_DIR "${_up1}/engine")
elseif(EXISTS "${_up2}/engine/rt64/CMakeLists.txt")
    set(ENGINE_DIR "${_up2}/engine")
else()
    message(FATAL_ERROR "no engine/ found above ${CMAKE_CURRENT_SOURCE_DIR}")
endif()
message(STATUS "engine: ${ENGINE_DIR}")
# ── RT64 configuration ────────────────────────────────────────────────────────
set(RT64_STATIC ON CACHE BOOL "" FORCE)
if (WIN32)
    set(SDL2_INCLUDE_DIRS
        "${ENGINE_DIR}/rt64/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/include"
        CACHE STRING "" FORCE)
    set(SDL2_LIBRARIES "SDL2" "SDL2main" CACHE STRING "" FORCE)
    link_directories(
        "${ENGINE_DIR}/rt64/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/lib/x64")
else()
    # Linux / macOS: use the system SDL2 (the bundled win32 deps are Windows-only).
    find_package(SDL2 REQUIRED)
endif()

if (WIN32)
    add_compile_definitions(NOMINMAX)
endif()

# ── The agnostic engine (single shared copy: ../engine) ───────────────────────
# Built ONCE. Under the sweep master project (recompilator builds many games in one
# tree) the engine targets already exist, so this is skipped — no rebuild, no
# double-definition. Built standalone, the engine is added here as before.
if (NOT TARGET rt64)
    add_subdirectory(${ENGINE_DIR}/rt64 rt64_build)
    add_subdirectory(${ENGINE_DIR}/runtime runtime_build)   # adds ultramodern + librecomp
endif()

# ── Recompiled C functions library ────────────────────────────────────────────
# N64Recomp outputs funcs_0.c … funcs_N.c (regenerable from ../{{GAME}}/{{GAME}}.toml).
# rsp/aspMain.cpp (audio ucode) + rsp/f3dex2.cpp are optional — the EXISTS guards skip them.
file(GLOB RECOMP_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/RecompiledFuncs/funcs_*.c")
if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/rsp/aspMain.cpp")
    list(APPEND RECOMP_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/rsp/aspMain.cpp")
endif()
if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/rsp/f3dex2.cpp")
    list(APPEND RECOMP_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/rsp/f3dex2.cpp")
endif()

add_library({{GAME}}_recomp STATIC ${RECOMP_SOURCES})

target_include_directories({{GAME}}_recomp PUBLIC
    "${ENGINE_DIR}/runtime/N64Recomp/include"
    "${CMAKE_CURRENT_SOURCE_DIR}/RecompiledFuncs"
    "${ENGINE_DIR}/runtime/librecomp/include"
    "${ENGINE_DIR}/runtime/ultramodern/include"
)

if (MSVC)
    target_compile_options({{GAME}}_recomp PRIVATE /GL-)
endif()

# ── Main executable ───────────────────────────────────────────────────────────
add_executable({{GAME}}pc WIN32
    src/main.cpp
    src/rt64_renderer.cpp
    src/audio.cpp
    src/input.cpp
    src/rsp.cpp
    src/patches/os_stubs.c
    src/patches/math_patches.c
    src/patches/engine_shims.c
)

target_include_directories({{GAME}}pc PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/src"
    "${ENGINE_DIR}/rt64/src"
    "${ENGINE_DIR}/rt64/src/hle"
    "${ENGINE_DIR}/rt64/src/rhi"
    "${ENGINE_DIR}/rt64/src/render"
    "${ENGINE_DIR}/rt64/src/contrib"
    "${ENGINE_DIR}/rt64/src/contrib/hlslpp/include"
    "${ENGINE_DIR}/rt64/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/include"
    "${ENGINE_DIR}/runtime/librecomp/include"
    "${ENGINE_DIR}/runtime/ultramodern/include"
    "${ENGINE_DIR}/runtime/N64Recomp/include"
    "${CMAKE_CURRENT_SOURCE_DIR}/RecompiledFuncs"
)

target_compile_definitions({{GAME}}pc PRIVATE HLSL_CPU)
if (WIN32)
    target_compile_definitions({{GAME}}pc PRIVATE WIN32_LEAN_AND_MEAN)
endif()

if (MSVC)
    target_link_options({{GAME}}pc PRIVATE /MAP)
endif()

target_link_libraries({{GAME}}pc PRIVATE
    {{GAME}}_recomp
    librecomp
    ultramodern
    rt64
)
if (WIN32)
    target_link_libraries({{GAME}}pc PRIVATE SDL2 SDL2main)
else()
    target_link_libraries({{GAME}}pc PRIVATE SDL2::SDL2)   # system SDL2 (find_package)
endif()

if (WIN32)
    set(SDL2_DLL
        "${ENGINE_DIR}/rt64/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3/lib/x64/SDL2.dll")
    add_custom_command(TARGET {{GAME}}pc POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${SDL2_DLL}" "$<TARGET_FILE_DIR:{{GAME}}pc>/SDL2.dll"
        COMMENT "Copying SDL2.dll")
    add_custom_command(TARGET {{GAME}}pc POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${ENGINE_DIR}/rt64/src/contrib/dxc/bin/x64/dxcompiler.dll"
            "$<TARGET_FILE_DIR:{{GAME}}pc>/dxcompiler.dll"
        COMMENT "Copying dxcompiler.dll")
    add_custom_command(TARGET {{GAME}}pc POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${ENGINE_DIR}/rt64/src/contrib/dxc/bin/x64/dxil.dll"
            "$<TARGET_FILE_DIR:{{GAME}}pc>/dxil.dll"
        COMMENT "Copying dxil.dll")
endif()
